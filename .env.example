# API Keys Configuration Template
# Copy this file to .env and fill in your actual API keys

# MEXC Exchange
MEXC_API_KEY=your_mexc_api_key_here
MEXC_API_SECRET=your_mexc_api_secret_here

# Gate.io Exchange
GATE_API_KEY=your_gate_api_key_here
GATE_API_SECRET=your_gate_api_secret_here

# Bybit Exchange
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here

# AsterDEX Exchange
ASTERDEX_API_KEY=your_asterdex_api_key_here
ASTERDEX_API_SECRET=your_asterdex_api_secret_here

# Telegram (optional - leave empty to disable notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
